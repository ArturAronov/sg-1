# LOCAL DEVELOPMENT ONLY. Generate a token with: openssl rand -hex 32
SG1_ENV=development
SG1_DEV_TOKEN=
# Separate encryption key for stored LLM API keys. Generated by scripts/setup.mjs.
# Back this up separately from PostgreSQL; changing it makes existing keys unreadable.
SG1_CREDENTIALS_KEY=
SG1_DATABASE_URL=postgres://sg1:sg1_local_only@127.0.0.1:55432/sg1?sslmode=disable
SG1_POSTGRES_PORT=55432
SG1_LISTEN_ADDR=127.0.0.1:8080
SG1_API_URL=http://127.0.0.1:8080
SG1_PUBLIC_URL=http://localhost:3000
